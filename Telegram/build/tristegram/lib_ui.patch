+QImage PopupMenu::GrabScreen(QRect global, QRect *grabbed) {
+	// Tristegram: taking the picture from the screen keeps us away from
+	// rendering every widget of the window again, which some of them
+	// do not survive.
+	const auto screen = QGuiApplication::screenAt(global.center());
+	if (!screen) {
+		return QImage();
+	}
+	const auto geometry = screen->geometry();
+	const auto part = global.intersected(geometry);
+	if (part.width() < 8 || part.height() < 8) {
+		return QImage();
+	}
+	auto image = screen->grabWindow(
+		0,
+		part.x() - geometry.x(),
+		part.y() - geometry.y(),
+		part.width(),
+		part.height()).toImage();
+	if (image.isNull()) {
+		return QImage();
+	}
+	if (image.width() != part.width()
+		&& std::abs(image.devicePixelRatio() - 1.) < 0.01) {
+		image.setDevicePixelRatio(image.width() / double(part.width()));
+	}
+	if (grabbed) {
+		*grabbed = part;
+	}
+	return image;
+}
+
+void PopupMenu::setupGlass() {
+	if (!GlassMenus || !_useTransparency) {
+		return;
+	}
+	_menu->setProperty("tristegramGlass", true);
+	_menu->setAttribute(Qt::WA_OpaquePaintEvent, false);
+	_glassBg.create(this);
+	_glassBg->setAttribute(Qt::WA_TransparentForMouseEvents);
+	_glassBg->lower();
+	sizeValue(
+	) | rpl::on_next([=](QSize size) {
+		_glassBg->setGeometry(QRect(QPoint(), size));
+		_glassBg->lower();
+	}, _glassBg->lifetime());
+	_glassBg->paintRequest(
+	) | rpl::on_next([=] {
+		if (_inner.isEmpty()) {
+			return;
+		}
+		auto p = QPainter(_glassBg.data());
+		p.setClipRect(_inner);
+		if (!_glassBackdrop.isNull()) {
+			p.drawImage(_inner.topLeft() + _glassOffset, _glassBackdrop);
+		}
+		auto tint = _st.menu.itemBg->c;
+		tint.setAlphaF(_glassBackdrop.isNull() ? 1. : 0.7);
+		p.fillRect(_inner, tint);
+	}, _glassBg->lifetime());
+}
+
+void PopupMenu::prepareGlass() {
+	_glassBackdrop = QImage();
+	if (!_glassBg || _inner.isEmpty()) {
+		return;
+	}
+	const auto parent = parentWidget();
+	const auto window = parent ? parent->window() : nullptr;
+	if (!window || window == this || !window->isVisible()) {
+		return;
+	}
+	const auto global = QRect(mapToGlobal(_inner.topLeft()), _inner.size());
+	auto grabbed = QRect();
+	auto image = GrabScreen(global, &grabbed);
+	if (image.isNull()) {
+		return;
+	}
+	const auto ratio = image.devicePixelRatio();
+	const auto full = image.size();
+	auto small = image.scaled(
+		std::max(1, full.width() / 6),
+		std::max(1, full.height() / 6),
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation
+	).convertToFormat(QImage::Format_ARGB32_Premultiplied);
+	small = Images::BlurLargeImage(std::move(small), 4);
+	_glassBackdrop = small.scaled(
+		full,
+		Qt::IgnoreAspectRatio,
+		Qt::SmoothTransformation);
+	_glassBackdrop.setDevicePixelRatio(ratio);
+	_glassOffset = grabbed.topLeft() - global.topLeft();
+	_glassBg->update();
 }
 
