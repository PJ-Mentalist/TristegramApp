+namespace style {
+namespace internal {
+class ColorData;
+} // namespace internal
+
+// Tristegram: a common look for monochrome icons. The provider returns
+// an effect for the palette color an icon is painted with, or nullptr
+// to keep that icon as it is.
+struct IconEffect {
+	QColor from; // invalid: the icon's own color
+	QColor to; // valid and different from `from`: a gradient
+	double angle = 135.; // gradient direction, degrees
+	double glow = 0.; // 0..1
+	unsigned int key = 0; // nonzero, unique for every effect
+};
+
+using IconEffectProvider = std::function<
+	const IconEffect*(const internal::ColorData*)>;
+
+void SetIconEffectProvider(IconEffectProvider provider);
+
+// Cached icon pictures are made again on their next paint.
+void RefreshIconEffects();
+
+// Tristegram: colors of the tiles under menu icons. An invalid `from`
+// keeps the default color for every icon, an invalid `icon` paints
+// the icon white.
+struct MenuTileColors {
+	QColor from;
+	QColor to;
+	QColor icon;
+};
+
+void SetMenuTileProvider(std::function<MenuTileColors()> provider);
+[[nodiscard]] MenuTileColors CurrentMenuTileColors();
+
+} // namespace style
