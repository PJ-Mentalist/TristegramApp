+// Tristegram: filled rounded field with a focus ring instead of the
+// underline, used when the field style has side text margins.
+void PaintTristegramField(
+		QPainter &p,
+		QRect rect,
+		QColor ring,
+		float64 ringOpacity) {
+	auto hq = PainterHighQualityEnabler(p);
+	const auto radius = style::ConvertScale(12);
+	p.setPen(Qt::NoPen);
+	p.setBrush(st::windowBgOver);
+	p.drawRoundedRect(QRectF(rect), radius, radius);
+	if (ringOpacity > 0.) {
+		ring.setAlphaF(ring.alphaF() * std::clamp(ringOpacity, 0., 1.));
+		const auto width = style::ConvertScale(2) * 0.75;
+		p.setPen(QPen(ring, width));
+		p.setBrush(Qt::NoBrush);
+		const auto half = width / 2.;
+		p.drawRoundedRect(
+			QRectF(rect).marginsRemoved(QMarginsF(half, half, half, half)),
+			radius - half,
+			radius - half);
+	}
+}
