"""
Wtogether для Tristegram — смотрим видео вместе с друзьями на ПК и на телефоне.

• Совместим с Wtogether для exteraGram: тот же протокол и коды комнат, друзья
  с телефона входят по тому же коду из 4 цифр, а ты — в их комнаты.
• Меню: боковое меню и меню чата → «🎬 Смотреть вместе», правый клик по сообщению
  со ссылкой на видео или с приглашением → «🎬 Смотреть вместе», клик по ссылке
  «▶️ Войти в комнату» в чате сразу открывает комнату.
• Плеер открывается в браузере (страница на 127.0.0.1): YouTube, .mp4 и .m3u8
  играют синхронно, лобби с готовностью, отсчёт 3-2-1, чат с отметками времени,
  реакции, участники и передача управления 👑, «✋ Подожди меня».
• Видео из Telegram, которое ведущий включил с телефона: сохрани его из чата
  и выбери файл в плеере — дальше синхронно.

Связь — через публичные MQTT-брокеры, как и у оригинала; в чат пишется только
приглашение.
"""

__id__ = "wtogether_exd"
__name__ = "Wtogether"
__description__ = "Смотрите видео вместе: комнаты по коду, совместимо с телефоном, плеер в браузере, чат и реакции"
__author__ = "Wtogether"
__version__ = "4.0.0"
__icon__ = "exteraPlugins/1"
__category__ = ["media", "chats"]
__desktop__ = True
__ported_from__ = "wtogether 4.0.0"
__desktop_os__ = "windows"

TICK_MS = 300            # цикл плеера
HEARTBEAT_S = 3.0        # ведущий обновляет состояние во время воспроизведения
COUNTDOWN_MS = 3000      # отсчёт перед стартом
SEEK_COOLDOWN = 1.5      # с: после перемотки даём плееру устояться
PING_EVERY = 20.0        # с: зритель уточняет разницу часов
SKIP_MS = 10000
SPEEDS = [1.0, 1.25, 1.5, 2.0, 0.75]
JOIN_HOST = "wtogether.join/"

ACCENT = "#FF3E8EF7"
ONLINE = "#FF4CD964"
OFFLINE = "#FF8E8E93"
WAITING = "#FFFFB340"


def html_escape(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


# ===== PURE START — чистый Python без Android, проверяется тестами в plugin/tools =====
import json
import random
import socket
import ssl
import threading
import time

NS = "wtogether4"
CODE_LEN = 4
# Публичные бесплатные MQTT-брокеры. Код комнаты указывает, на каком брокере она живёт.
BROKERS = [
    ("broker.emqx.io", [(1883, False), (8883, True)]),
    ("broker.hivemq.com", [(1883, False), (8883, True)]),
    ("test.mosquitto.org", [(1883, False), (8886, True)]),
]
KEEPALIVE = 30
ZW0, ZW1, ZWM = "​", "‌", "⁣"

SMALL_DRIFT = 150        # мс: меньше — не трогаем
BIG_DRIFT = 2000         # мс: больше — перематываем, между — подстраиваем скорость
NUDGE = 0.08             # насколько ускоряем/замедляем при подстройке
NUDGE_DONE = 80          # мс: до какого расхождения подтягиваем, раз начали


def now_ms():
    return int(time.time() * 1000)


def fmt_time(ms):
    s = max(0, int(ms) // 1000)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def new_code(broker_index):
    """4 цифры; первая говорит, на каком брокере комната (цифра % число брокеров)."""
    n = len(BROKERS)
    first = random.choice([d for d in "0123456789" if int(d) % n == broker_index])
    return first + "".join(random.choice("0123456789") for _ in range(CODE_LEN - 1))


def normalize_code(text):
    """«48 21» → «4821». None, если это не код."""
    code = "".join(c for c in str(text or "") if c.isdigit())
    return code if len(code) == CODE_LEN else None


def broker_of(code):
    return int(code[0]) % len(BROKERS)


def youtube_id(url):
    import re
    m = re.search(r"(?:youtu\.be/|youtube(?:-nocookie)?\.com/(?:watch\?(?:.*&)?v=|embed/|shorts/|live/|v/))([\w-]{11})",
                  url or "")
    return m.group(1) if m else None


def media_from_url(url):
    """Ссылка → описание источника для комнаты или None."""
    url = (url or "").strip()
    if not url.lower().startswith(("http://", "https://")):
        return None
    yt = youtube_id(url)
    if yt:
        return {"src": "yt", "yt": yt, "title": "YouTube"}
    name = url.split("?")[0].rstrip("/").split("/")[-1] or "Видео по ссылке"
    return {"src": "url", "url": url, "title": name[:60]}


def zw_encode(obj):
    raw = json.dumps(obj, separators=(",", ":")).encode("utf-8")
    return ZWM + "".join(ZW1 if bit == "1" else ZW0 for b in raw for bit in f"{b:08b}") + ZWM


def zw_decode(text):
    if not text:
        return None
    i = text.find(ZWM)
    j = text.find(ZWM, i + 1) if i >= 0 else -1
    if i < 0 or j < 0:
        return None
    bits = "".join("1" if c == ZW1 else "0" for c in text[i + 1:j] if c in (ZW0, ZW1))
    if not bits or len(bits) % 8:
        return None
    try:
        return json.loads(bytes(int(bits[k:k + 8], 2) for k in range(0, len(bits), 8)).decode("utf-8"))
    except Exception:
        return None


def expected_pos(st, room_now):
    """Где сейчас должен быть ведущий по последнему состоянию."""
    if not st["p"]:
        return st["pos"]
    return st["pos"] + max(0, room_now - st["ts"]) * st["r"]


def plan_correction(st, room_now, cur, playing, nudging=False):
    """Что сделать зрителю, чтобы совпасть с ведущим.
    Возвращает (play, seek_to или None, speed, nudging)."""
    target = expected_pos(st, room_now)
    diff = cur - target
    if not st["p"] or room_now < st["ts"]:          # пауза или ещё идёт отсчёт
        return False, (int(target) if abs(diff) > SMALL_DRIFT else None), st["r"], False
    if not playing:                                 # запускаемся — встаём точно на место
        return True, (int(target) if abs(diff) > NUDGE_DONE else None), st["r"], False
    if abs(diff) > BIG_DRIFT:
        return True, int(target), st["r"], False
    if abs(diff) > SMALL_DRIFT or (nudging and abs(diff) > NUDGE_DONE):
        return True, None, st["r"] * (1 - NUDGE if diff > 0 else 1 + NUDGE), True
    return True, None, st["r"], False


# ---------- минимальный MQTT 3.1.1 клиент (QoS 0, retain, last will) ----------

def _enc_len(n):
    out = bytearray()
    while True:
        b = n % 128
        n //= 128
        out.append(b | (0x80 if n else 0))
        if not n:
            return bytes(out)


def _enc_str(s):
    b = s.encode("utf-8") if isinstance(s, str) else bytes(s)
    return len(b).to_bytes(2, "big") + b


def _packet(first, body):
    return bytes([first]) + _enc_len(len(body)) + body


class MqttClient:
    """Сам переподключается, переподписывается и вызывает on_connect после каждого подключения."""

    def __init__(self, on_message, on_connect=None, on_status=None, log=None):
        self.on_message = on_message
        self.on_connect = on_connect
        self.on_status = on_status or (lambda s: None)
        self.log = log or (lambda s: None)
        self.client_id = "wt3-" + "".join(random.choice("0123456789abcdef") for _ in range(12))
        self.endpoints = []
        self.will = None
        self.subs = []
        self.sock = None
        self.lock = threading.Lock()
        self.connected = False
        self.running = False
        self.thread = None
        self.pid = 1
        self.endpoint = None

    def configure(self, endpoints, will=None):
        self.endpoints = list(endpoints)
        self.will = will

    def start(self):
        self.running = True
        self.thread = threading.Thread(target=self._run, name="wtogether-mqtt", daemon=True)
        self.thread.start()

    def stop(self, graceful=True):
        self.running = False
        s = self.sock
        if s is not None:
            try:
                if graceful and self.connected:
                    self._send(b"\xe0\x00")      # DISCONNECT — брокер не шлёт «завещание»
            except Exception:
                pass
            try:
                s.close()
            except Exception:
                pass

    def subscribe(self, topic):
        if topic not in self.subs:
            self.subs.append(topic)
        if self.connected:
            self._subscribe(topic)

    def publish(self, topic, payload, retain=False):
        if isinstance(payload, (dict, list)):
            payload = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
        if isinstance(payload, str):
            payload = payload.encode("utf-8")
        if not self.connected:
            return False
        try:
            self._send(_packet(0x30 | (1 if retain else 0), _enc_str(topic) + payload))
            return True
        except Exception as e:
            self.log(f"publish: {e}")
            self._drop()
            return False

    # --- внутреннее ---

    def _send(self, data):
        with self.lock:
            self.sock.sendall(data)

    def _subscribe(self, topic):
        self.pid = self.pid % 65000 + 1
        body = self.pid.to_bytes(2, "big") + _enc_str(topic) + b"\x00"
        self._send(_packet(0x82, body))

    def _drop(self):
        self.connected = False
        try:
            if self.sock is not None:
                self.sock.close()
        except Exception:
            pass

    def _connect(self, host, port, tls):
        raw = socket.create_connection((host, port), timeout=8)
        if tls:
            ctx = ssl.create_default_context()
            raw = ctx.wrap_socket(raw, server_hostname=host)
        raw.settimeout(1.0)
        self.sock = raw
        flags = 0x02  # clean session
        payload = _enc_str(self.client_id)
        if self.will:
            topic, msg, retain = self.will
            flags |= 0x04 | (0x20 if retain else 0)
            payload += _enc_str(topic) + _enc_str(msg if isinstance(msg, (bytes, bytearray)) else
                                                   json.dumps(msg, separators=(",", ":")))
        body = _enc_str("MQTT") + bytes([4, flags]) + KEEPALIVE.to_bytes(2, "big") + payload
        self._send(_packet(0x10, body))
        deadline = time.time() + 8
        buf = bytearray()
        while len(buf) < 4:
            if time.time() > deadline:
                raise OSError("нет ответа брокера")
            try:
                chunk = raw.recv(4 - len(buf))
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("брокер закрыл соединение")
            buf += chunk
        if buf[0] != 0x20 or buf[3] != 0:
            raise OSError(f"брокер отказал: {buf[3]}")

    def _run(self):
        attempt = 0
        while self.running:
            ok = False
            for host, port, tls in self.endpoints:
                if not self.running:
                    return
                try:
                    self.on_status("подключаюсь")
                    self._connect(host, port, tls)
                    self.connected = True
                    self.endpoint = f"{host}:{port}"
                    attempt = 0
                    for t in self.subs:
                        self._subscribe(t)
                    self.on_status("на связи")
                    if self.on_connect:
                        try:
                            self.on_connect()
                        except Exception as e:
                            self.log(f"on_connect: {e}")
                    self._loop()
                    ok = True
                except Exception as e:
                    self.log(f"{host}:{port} — {e}")
                finally:
                    self._drop()
                if not self.running:
                    return
                if ok:
                    break
            self.on_status("нет связи, переподключаюсь")
            attempt += 1
            time.sleep(min(10, 1 + attempt))

    def _loop(self):
        buf = bytearray()
        last_rx = last_tx = time.time()
        while self.running and self.connected:
            now = time.time()
            if now - last_tx > KEEPALIVE / 2:
                self._send(b"\xc0\x00")       # PINGREQ
                last_tx = now
            if now - last_rx > KEEPALIVE * 1.5:
                raise OSError("брокер молчит")
            try:
                chunk = self.sock.recv(4096)
            except socket.timeout:
                continue
            if not chunk:
                raise OSError("соединение закрыто")
            last_rx = time.time()
            buf += chunk
            while True:
                if len(buf) < 2:
                    break
                mult, length, i = 1, 0, 1
                while True:
                    if i >= len(buf):
                        length = None
                        break
                    b = buf[i]
                    length += (b & 0x7F) * mult
                    mult *= 128
                    i += 1
                    if not b & 0x80:
                        break
                if length is None or len(buf) < i + length:
                    break
                first, body = buf[0], bytes(buf[i:i + length])
                del buf[:i + length]
                if first >> 4 == 3:                      # PUBLISH
                    tl = int.from_bytes(body[:2], "big")
                    topic = body[2:2 + tl].decode("utf-8", "replace")
                    pos = 2 + tl + (2 if (first >> 1) & 3 else 0)
                    try:
                        self.on_message(topic, body[pos:])
                    except Exception as e:
                        self.log(f"on_message: {e}")


# ---------- комната ----------

class Room:
    """Протокол комнаты поверх MQTT. Топики под NS/КОД/:
      room      — инфо: источник видео, ведущий (retained). Смена поля host = передача управления
      st        — состояние воспроизведения (retained, пишет текущий ведущий)
      end       — ведущий закончил (retained)
      p/<uid>   — присутствие участника (retained; «завещание» — ушёл)
      chat, react, wait — сообщения, реакции, просьба «подожди меня»
      ping/<uid>, pong/<uid> — сверка часов с ведущим
    """

    CLAIM_WAIT = 1.5    # с: сколько ждём, не занят ли код, прежде чем занять

    def __init__(self, uid, name, events, clock=now_ms, client_factory=None, endpoints=None):
        self.uid = int(uid)
        self.name = name
        self.ev = events
        self.clock = clock
        self.code = None
        self.role = None
        self.info = None
        self.st = None
        self.members = {}
        self.offset = 0
        self.rtt = None
        self.samples = []
        self.ended = False
        self.claimed = False
        self.foreign = None          # чужая комната с этим кодом, замеченная до занятия
        self.presence = {"s": "joined", "pc": 0}
        self._client_factory = client_factory or MqttClient
        self._endpoints = endpoints
        self.client = None
        self.status = "подключаюсь"

    # --- общее ---

    def t(self, suffix):
        return f"{NS}/{self.code}/{suffix}"

    def host_uid(self):
        return self.uid if self.role == "host" else int((self.info or {}).get("host") or 0)

    def room_now(self):
        return self.clock() + (self.offset if self.role == "guest" else 0)

    def _endpoints_for(self, code):
        if self._endpoints is not None:
            return self._endpoints
        host, ports = BROKERS[broker_of(code)]
        return [(host, p, tls) for p, tls in ports]

    def _emit(self, name, *args, **kw):
        cb = getattr(self.ev, name, None)
        if cb:
            cb(*args, **kw)

    def _start(self):
        self.client = self._client_factory(self._on_message, self._on_connect, self._on_status,
                                           getattr(self.ev, "on_log", None))
        self.client.configure(self._endpoints_for(self.code), (self.t(f"p/{self.uid}"), {"s": "gone"}, True))
        self.client.subscribe(f"{NS}/{self.code}/#")
        self.client.start()

    def _on_status(self, s):
        self.status = s
        self._emit("on_status", s)

    def _on_connect(self):
        self._publish_presence()
        if self.role == "host":
            if self.claimed:
                self._publish_room()
            else:
                threading.Timer(self.CLAIM_WAIT, self._claim).start()
        else:
            self.ping()

    def _claim(self):
        """Код свободен, если нет комнаты или её ведущий не в сети."""
        f = self.foreign
        if f and int(f.get("host") or 0) in self.members:
            self._emit("on_code_taken")
            return
        self.claimed = True
        self._publish_room()
        self._emit("on_claimed")

    def _publish_room(self):
        c = self.client
        if c is None:
            return
        c.publish(self.t("end"), b"", retain=True)
        c.publish(self.t("room"), self.info, retain=True)
        if self.st is not None:
            c.publish(self.t("st"), self.st, retain=True)

    def _publish_presence(self):
        p = dict(self.presence)
        p.update({"n": self.name, "host": self.role == "host", "ts": self.clock()})
        self.members[self.uid] = p
        if self.client is not None:
            self.client.publish(self.t(f"p/{self.uid}"), p, retain=True)

    # --- ведущий ---

    def host(self, code, info):
        self.role, self.code = "host", code
        self.info = dict(info, host=self.uid, hn=self.name, v=4)
        self.presence = {"s": "ready", "pc": 100}
        self._start()

    def publish_state(self, p, pos, r, ts=None):
        self.st = {"p": bool(p), "pos": int(pos), "r": float(r), "ts": int(ts if ts is not None else self.clock())}
        if self.client is not None and self.claimed:
            self.client.publish(self.t("st"), self.st, retain=True)

    def transfer(self, uid):
        """Отдать управление участнику uid."""
        if self.role != "host" or uid not in self.members:
            return False
        self.info = dict(self.info, host=int(uid), hn=self.members[uid].get("n") or "")
        self.client.publish(self.t("room"), self.info, retain=True)
        return True

    # --- зритель ---

    def join(self, code):
        self.role, self.code = "guest", code
        self._start()

    def ping(self):
        if self.client is not None and self.role == "guest":
            self.client.publish(self.t(f"ping/{self.uid}"), {"a": self.clock()})

    def set_progress(self, stage, pc=0):
        self.presence = {"s": stage, "pc": int(pc)}
        self._publish_presence()

    def ask_wait(self):
        if self.client is not None:
            self.client.publish(self.t("wait"), {"u": self.uid, "n": self.name})

    # --- все ---

    def chat(self, text, at):
        msg = {"u": self.uid, "n": self.name, "x": text[:300], "at": int(at)}
        if self.client is not None:
            self.client.publish(self.t("chat"), msg)
        return msg

    def react(self, emoji):
        if self.client is not None:
            self.client.publish(self.t("react"), {"u": self.uid, "n": self.name, "e": emoji[:8]})

    def close(self):
        """Ведущий — закончить для всех, зритель — выйти."""
        c = self.client
        if c is None:
            return
        if self.role == "host" and self.claimed:
            c.publish(self.t("end"), {"end": 1, "ts": self.clock()}, retain=True)
            c.publish(self.t("st"), b"", retain=True)
            c.publish(self.t("room"), b"", retain=True)
        c.publish(self.t(f"p/{self.uid}"), b"", retain=True)
        time.sleep(0.2)
        c.stop(graceful=True)
        self.client = None

    # --- входящие ---

    def _on_message(self, topic, payload):
        prefix = f"{NS}/{self.code}/"
        if not topic.startswith(prefix):
            return
        key = topic[len(prefix):]
        data = None
        if payload:
            try:
                data = json.loads(payload.decode("utf-8"))
            except Exception:
                return

        if key == "room":
            if not data:
                return
            new_host = int(data.get("host") or 0)
            if self.role == "host" and not self.claimed:
                if new_host != self.uid:
                    self.foreign = data
                return
            prev_host = self.host_uid()
            self.info = data
            if self.role == "guest" and new_host == self.uid:
                self.role = "host"
                self.claimed = True
                self.offset, self.samples = 0, []
                self._publish_presence()
                self._emit("on_role", "host")
            elif self.role == "host" and new_host != self.uid:
                self.role = "guest"
                self.samples = []
                self._publish_presence()
                self.ping()
                self._emit("on_role", "guest")
            elif self.role == "guest":
                if prev_host and prev_host != new_host:
                    self.samples = []
                    self.ping()
                    self._emit("on_host_changed", new_host)
                self._emit("on_room", data)
        elif key == "st":
            if data and self.role == "guest":
                self.st = data
                self._emit("on_state", data)
        elif key == "end":
            if data and self.role == "guest" and not self.ended:
                self.ended = True
                self._emit("on_end")
        elif key.startswith("p/"):
            try:
                uid = int(key[2:])
            except ValueError:
                return
            if uid == self.uid:
                return
            if not data or data.get("s") == "gone":
                if self.members.pop(uid, None) is not None:
                    self._emit("on_members", self.members, left=uid)
            else:
                new = uid not in self.members
                self.members[uid] = data
                self._emit("on_members", self.members, joined=uid if new else None)
        elif key == "chat":
            if data and int(data.get("u") or 0) != self.uid:
                self._emit("on_chat", data)
        elif key == "react":
            if data and int(data.get("u") or 0) != self.uid:
                self._emit("on_react", data)
        elif key == "wait":
            if data and self.role == "host" and int(data.get("u") or 0) != self.uid:
                self._emit("on_wait", data)
        elif key.startswith("ping/") and self.role == "host" and data:
            self.client.publish(self.t("pong/" + key[5:]), {"a": data.get("a"), "b": self.clock()})
        elif key == f"pong/{self.uid}" and self.role == "guest" and data:
            a, b = int(data.get("a") or 0), int(data.get("b") or 0)
            rtt = self.clock() - a
            if a and b and rtt >= 0:
                self.samples = (self.samples + [(rtt, b + rtt // 2 - self.clock())])[-8:]
                self.rtt, self.offset = min(self.samples)
# ===== PURE END =====


# ===== TRISTEGRAM DESKTOP =====
# Плеер — страница на 127.0.0.1, её открывает браузер. Плагин держит комнату
# (тот же протокол, что и на телефоне) и передаёт события странице.

import http.server
import os
import queue
import secrets
import socketserver
import urllib.parse

from base_plugin import BasePlugin, MenuItemData, MenuItemType, MethodHook
from hook_utils import find_class
from client_utils import send_text, get_user_config, get_messages_controller
try:
    # Tristegram: окно плеера внутри клиента и видео из чатов.
    from client_utils import open_webview, fetch_telegram_video, fetch_telegram_video_status
except ImportError:
    open_webview = fetch_telegram_video = fetch_telegram_video_status = None
try:
    from file_utils import get_plugin_cache_dir
except ImportError:
    get_plugin_cache_dir = None
from android_utils import run_on_ui_thread, copy_to_clipboard
from ui.bulletin import BulletinHelper
from ui.settings import Header, Switch, Text, Divider

HOST_WAIT_S = 10.0       # брокер не ответил за это время — пробуем следующий
JOIN_WAIT_S = 12.0       # комната не нашлась за это время — сообщаем
CHAT_KEEP = 150


def find_url(text):
    import re
    m = re.search(r"https?://[^\s<>\"']+", text or "")
    return m.group(0).rstrip(".,)") if m else None


def find_code(text):
    """Код из приглашения: невидимая метка, ссылка wtogether.join/1234 или «Комната 1234»."""
    data = zw_decode(text or "")
    if isinstance(data, dict) and data.get("t") == "code":
        code = normalize_code(data.get("c"))
        if code:
            return code
    s = text or ""
    i = s.find(JOIN_HOST)
    if i >= 0:
        code = normalize_code(s[i + len(JOIN_HOST):i + len(JOIN_HOST) + 8])
        if code:
            return code
    import re
    m = re.search(r"[Кк]омнат[аы]\s*(\d{4})", s)
    return m.group(1) if m else None


def message_text(context):
    if (context or {}).get("message_text"):
        return str(context["message_text"])
    m = (context or {}).get("message")
    if m is None:
        return ""
    if isinstance(m, dict):
        return str(m.get("text") or m.get("message") or "")
    for path in (("messageOwner", "message"), ("messageText",), ("message",), ("text",)):
        v = m
        try:
            for name in path:
                v = getattr(v, name)
            if v:
                return str(v)
        except Exception:
            continue
    return ""


class Hub:
    """Рассылает события всем открытым страницам плеера."""

    def __init__(self):
        self.lock = threading.Lock()
        self.clients = []

    def subscribe(self):
        q = queue.Queue(maxsize=500)
        with self.lock:
            self.clients.append(q)
        return q

    def unsubscribe(self, q):
        with self.lock:
            if q in self.clients:
                self.clients.remove(q)

    def push(self, event):
        with self.lock:
            clients = list(self.clients)
        for q in clients:
            try:
                q.put_nowait(event)
            except queue.Full:
                pass

    def count(self):
        with self.lock:
            return len(self.clients)


class Session:
    """Одна комната: связывает протокол Room со страницей плеера."""

    def __init__(self, plugin):
        self.p = plugin
        self.hub = Hub()
        self.lock = threading.RLock()
        self.room = None
        self.info = None
        self.chat_did = 0
        self.broker_index = 0
        self.history = []
        self.notice = None
        self.shared = False
        self.ping_timer = None
        self.media = None          # видео из Telegram: {"doc", "job", "state", "ready", "total", "path"}

    # --- что знает страница ---

    def snapshot(self):
        with self.lock:
            r = self.room
            data = {
                "t": "snapshot",
                "me": self.p.my_uid(),
                "name": self.p.my_name(),
                "chatTarget": bool(self.chat_did),
                "chat": list(self.history),
                "notice": self.notice,
                "media": self.media_public(),
            }
            if r is None:
                data["room"] = None
                return data
            data["room"] = {
                "code": r.code,
                "role": r.role,
                "claimed": r.claimed,
                "info": r.info or self.info,
                "st": r.st,
                "offset": r.offset if r.role == "guest" else 0,
                "rtt": r.rtt,
                "members": {str(k): v for k, v in r.members.items()},
                "host": r.host_uid(),
                "status": r.status,
                "ended": r.ended,
                "broker": BROKERS[broker_of(r.code)][0] if r.code else "",
            }
            return data

    def push(self, event):
        self.hub.push(event)

    def push_snapshot(self):
        self.hub.push(self.snapshot())

    # --- видео из Telegram ---

    def media_public(self):
        m = self.media
        if not m:
            return None
        data = {k: m.get(k) for k in ("doc", "state", "ready", "total")}
        if m.get("state") == "done":
            data["url"] = f"/media?t={self.p.server.token}&v={m.get('doc')}"
        return data

    def fetch_media(self, doc, host_uid, dialog_id=0, message_id=0):
        """Ищем и скачиваем видео из Telegram, чтобы показать его в плеере."""
        doc = int(doc or 0)
        if self.media and self.media.get("doc") == doc and self.media.get("state") in ("searching", "loading", "done"):
            return
        if not doc or fetch_telegram_video is None or get_plugin_cache_dir is None:
            self.media = {"doc": doc, "state": "unsupported"}
            self.push({"t": "media", "media": self.media_public()})
            return
        path = os.path.join(get_plugin_cache_dir(), f"tg_{doc}.mp4")
        job = fetch_telegram_video(int(host_uid or 0), doc, path, int(dialog_id or 0), int(message_id or 0))
        if not job:
            self.media = {"doc": doc, "state": "unsupported"}
            self.push({"t": "media", "media": self.media_public()})
            return
        self.media = {"doc": doc, "job": job, "state": "searching", "ready": 0, "total": 0, "path": path}
        self.push({"t": "media", "media": self.media_public()})

        def poll():
            last = None
            while self.media and self.media.get("job") == job:
                st = fetch_telegram_video_status(job)
                m = self.media
                if m is None or m.get("job") != job:
                    return
                m.update({k: st.get(k) for k in ("state", "ready", "total") if k in st})
                if st.get("path"):
                    m["path"] = st["path"]
                key = (m.get("state"), int((m.get("ready") or 0) * 50 / max(m.get("total") or 1, 1)))
                if key != last:
                    last = key
                    self.push({"t": "media", "media": self.media_public()})
                    r = self.room
                    if r is not None and r.role == "guest" and m.get("state") == "loading" and m.get("total"):
                        r.set_progress("loading", int(m["ready"] * 100 / m["total"]))
                if m.get("state") in ("done", "missing", "error"):
                    return
                time.sleep(0.5)

        threading.Thread(target=poll, daemon=True).start()

    # --- создание и вход ---

    def start_host(self, info, chat_did=0, origin=None):
        with self.lock:
            self.close_room(silent=True)
            self.media = None
            self.info = dict(info)
            self.chat_did = int(chat_did or 0)
            self.history = []
            self.shared = False
            self.notice = None
            self.broker_index = 0
            self._new_host_room()
        if info.get("src") == "tg":
            o = origin or {}
            self.fetch_media(info.get("doc"), self.p.my_uid(), o.get("dialog_id"), o.get("message_id"))
        self.push_snapshot()

    def _new_host_room(self):
        self.room = Room(self.p.my_uid(), self.p.my_name(), RoomEvents(self))
        self.room.host(new_code(self.broker_index), self.info)
        r, bi = self.room, self.broker_index
        threading.Timer(HOST_WAIT_S, lambda: self._check_host(r, bi)).start()

    def _check_host(self, r, bi):
        with self.lock:
            if self.room is not r or r.claimed or bi + 1 >= len(BROKERS):
                if self.room is r and not r.claimed:
                    self.notice = "Нет связи с серверами комнат. Проверь интернет и разреши плагину подключение."
                    self.push_snapshot()
                return
            self.p.log(f"брокер {BROKERS[bi][0]} не отвечает, пробую следующий")
            self.close_room(silent=True)
            self.broker_index = bi + 1
            self._new_host_room()
        self.push_snapshot()

    def join(self, code, chat_did=0):
        code = normalize_code(code)
        if not code:
            self.push({"t": "toast", "text": "Код комнаты — 4 цифры"})
            return False
        with self.lock:
            if self.room is not None and self.room.code == code:
                self.push_snapshot()
                return True
            self.close_room(silent=True)
            self.info = None
            self.media = None
            self.chat_did = int(chat_did or 0)
            self.history = []
            self.notice = None
            self.room = Room(self.p.my_uid(), self.p.my_name(), RoomEvents(self))
            self.room.join(code)
            r = self.room
            threading.Timer(JOIN_WAIT_S, lambda: self._check_join(r)).start()
            self._schedule_ping()
        self.push_snapshot()
        return True

    def _check_join(self, r):
        with self.lock:
            if self.room is not r or r.role != "guest":
                return
            if r.info is None:
                ended = r.ended
                self.close_room(silent=True)
                self.notice = ("Просмотр в этой комнате уже закончился." if ended else
                               "Комната не найдена. Проверь код: если он верный, у ведущего или у тебя нет интернета.")
            elif r.host_uid() not in r.members:
                self.push({"t": "toast", "text": "Ведущий сейчас не в сети — ждём его"})
                return
            else:
                return
        self.push_snapshot()

    def _schedule_ping(self):
        if self.ping_timer is not None:
            self.ping_timer.cancel()
        r = self.room

        def tick():
            with self.lock:
                if self.room is not r or r is None:
                    return
                if r.role == "guest":
                    r.ping()
            # Сверка часов приходит за доли секунды, отдаём её странице.
            threading.Timer(1.5, lambda: self.push({
                "t": "clock",
                "offset": r.offset if r.role == "guest" else 0,
                "rtt": r.rtt,
            })).start()
            self._schedule_ping()

        self.ping_timer = threading.Timer(PING_EVERY if r and r.rtt is not None else 3.0, tick)
        self.ping_timer.daemon = True
        self.ping_timer.start()

    def close_room(self, silent=False):
        with self.lock:
            r = self.room
            self.room = None
            if self.ping_timer is not None:
                self.ping_timer.cancel()
                self.ping_timer = None
        if r is not None:
            threading.Thread(target=r.close, daemon=True).start()
        if not silent:
            self.push_snapshot()

    # --- команды со страницы ---

    def command(self, a):
        kind = a.get("a")
        r = self.room
        if kind == "host":
            info = media_from_url(a.get("url"))
            if not info:
                return {"ok": False, "error": "Нужна ссылка https://… на YouTube или видеофайл (.mp4, .m3u8)"}
            self.start_host(info, self.chat_did if a.get("keepChat") else 0)
            return {"ok": True}
        if kind == "join":
            return {"ok": self.join(a.get("code"), self.chat_did if a.get("keepChat") else 0)}
        if kind == "snapshot":
            return self.snapshot()
        if r is None:
            return {"ok": False, "error": "Сейчас нет комнаты"}
        if kind == "state":
            if r.role == "host":
                r.publish_state(bool(a.get("p")), int(a.get("pos") or 0), float(a.get("r") or 1.0),
                                int(a["ts"]) if a.get("ts") else None)
                self.push({"t": "state", "st": r.st, "offset": 0})
        elif kind == "progress":
            r.set_progress(str(a.get("stage") or "ready"), int(a.get("pc") or 0))
            self.push({"t": "members", "members": {str(k): v for k, v in r.members.items()},
                       "host": r.host_uid()})
        elif kind == "chat":
            text = str(a.get("text") or "").strip()
            if text:
                msg = r.chat(text, int(a.get("at") or 0))
                self._remember(msg)
                self.push({"t": "chat", "msg": msg, "mine": True})
        elif kind == "react":
            r.react(str(a.get("e") or "❤️"))
        elif kind == "wait":
            r.ask_wait()
        elif kind == "ping":
            r.ping()
        elif kind == "transfer":
            if not r.transfer(int(a.get("uid") or 0)):
                return {"ok": False, "error": "Нельзя передать управление"}
            self.push_snapshot()
        elif kind == "invite":
            return self.invite(int(a.get("did") or 0))
        elif kind == "copy":
            copy_to_clipboard(self.invite_plain())
            return {"ok": True, "text": "Приглашение скопировано"}
        elif kind == "leave":
            self.close_room()
        return {"ok": True}

    def _remember(self, msg):
        self.history = (self.history + [msg])[-CHAT_KEEP:]

    # --- приглашения ---

    def invite_text(self):
        r = self.room
        title = ((r.info if r else None) or self.info or {}).get("title") or "видео"
        return (f"🎬 <b>Смотрим вместе</b> — {html_escape(title)}\n"
                f"Комната <code>{r.code}</code>\n\n"
                f'<a href="https://{JOIN_HOST}{r.code}">▶️ Войти в комнату</a>\n'
                "<i>Нужен плагин Wtogether для exteraGram или Tristegram</i>"
                + zw_encode({"t": "code", "c": r.code}))

    def invite_plain(self):
        r = self.room
        if r is None:
            return ""
        return (f"🎬 Смотрим вместе! Комната {r.code}\nhttps://{JOIN_HOST}{r.code}"
                + zw_encode({"t": "code", "c": r.code}))

    def invite(self, did=0):
        r = self.room
        did = did or self.chat_did
        if r is None or not r.code:
            return {"ok": False, "error": "Комната ещё не готова"}
        if not did:
            copy_to_clipboard(self.invite_plain())
            return {"ok": True, "text": "Приглашение скопировано — вставь его в любой чат"}
        try:
            send_text(did, self.invite_text(), parse_mode="HTML")
        except Exception as e:
            self.p.log(f"приглашение: {e}")
            send_text(did, self.invite_plain())
        return {"ok": True, "text": "Приглашение отправлено в чат"}


class RoomEvents:
    """События протокола (сетевой поток) → страница плеера."""

    def __init__(self, session):
        self.s = session

    def _members(self, r):
        return {str(k): v for k, v in r.members.items()}

    def on_status(self, status):
        self.s.push({"t": "status", "status": status})

    def on_claimed(self):
        s = self.s
        s.push_snapshot()
        if s.chat_did and not s.shared and s.p.get_setting("auto_invite", True):
            s.shared = True
            res = s.invite()
            s.push({"t": "toast", "text": res.get("text") or ""})

    def on_code_taken(self):
        s = self.s
        with s.lock:
            if s.room is None or s.room.role != "host":
                return
            s.close_room(silent=True)
            s._new_host_room()
        s.push_snapshot()

    def on_role(self, role):
        self.s.push_snapshot()
        self.s.push({"t": "toast", "text": "👑 Теперь ты управляешь просмотром" if role == "host"
                     else "Управление передано"})

    def on_host_changed(self, uid):
        r = self.s.room
        name = (r.members.get(uid) or {}).get("n") if r else None
        self.s.push_snapshot()
        self.s.push({"t": "toast", "text": f"👑 Управляет {name or 'новый ведущий'}"})

    def on_room(self, info):
        self.s.info = info
        if (info or {}).get("src", "tg") == "tg" and info.get("doc"):
            self.s.fetch_media(info.get("doc"), info.get("host"))
        self.s.push_snapshot()

    def on_state(self, st):
        r = self.s.room
        self.s.push({"t": "state", "st": st, "offset": r.offset if r else 0})

    def on_end(self):
        s = self.s
        s.notice = "Ведущий закончил просмотр."
        s.close_room()

    def on_members(self, members, joined=None, left=None):
        r = self.s.room
        if r is None:
            return
        self.s.push({"t": "members", "members": self._members(r), "host": r.host_uid(),
                     "joined": joined, "left": left})

    def on_chat(self, msg):
        self.s._remember(msg)
        self.s.push({"t": "chat", "msg": msg})

    def on_react(self, msg):
        self.s.push({"t": "react", "msg": msg})

    def on_wait(self, msg):
        self.s.push({"t": "wait", "msg": msg})

    def on_log(self, text):
        self.s.p.log(f"связь: {text}")


class PlayerServer:
    """HTTP на 127.0.0.1: страница плеера, поток событий и команды."""

    def __init__(self, session):
        self.session = session
        self.token = secrets.token_urlsafe(16)
        self.httpd = None
        self.port = 0

    def start(self):
        if self.httpd is not None:
            return
        server = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *args):
                pass

            def _query(self):
                parsed = urllib.parse.urlparse(self.path)
                return parsed.path, urllib.parse.parse_qs(parsed.query)

            def _allowed(self, query):
                return secrets.compare_digest((query.get("t") or [""])[0], server.token)

            def _send(self, code, body, kind="application/json; charset=utf-8"):
                data = body.encode("utf-8") if isinstance(body, str) else body
                self.send_response(code)
                self.send_header("Content-Type", kind)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                self.wfile.write(data)

            def do_GET(self):
                path, query = self._query()
                if not self._allowed(query):
                    self._send(403, "{}")
                    return
                if path == "/":
                    page = PLAYER_HTML.replace("__TOKEN__", server.token)
                    self._send(200, page, "text/html; charset=utf-8")
                elif path == "/events":
                    self._events()
                elif path == "/media":
                    self._media()
                else:
                    self._send(404, "{}")

            def _media(self):
                m = server.session.media or {}
                path = m.get("path")
                if m.get("state") != "done" or not path or not os.path.isfile(path):
                    self._send(404, "{}")
                    return
                size = os.path.getsize(path)
                start, end = 0, size - 1
                rng = self.headers.get("Range") or ""
                partial = rng.startswith("bytes=")
                if partial:
                    a, _, b = rng[6:].split(",")[0].partition("-")
                    if a:
                        start = int(a)
                        end = int(b) if b else size - 1
                    else:
                        start = max(0, size - int(b or 0))
                    end = min(end, size - 1)
                if start > end:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.end_headers()
                    return
                self.send_response(206 if partial else 200)
                self.send_header("Content-Type", "video/mp4")
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("Content-Length", str(end - start + 1))
                if partial:
                    self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
                self.end_headers()
                try:
                    with open(path, "rb") as f:
                        f.seek(start)
                        left = end - start + 1
                        while left > 0:
                            chunk = f.read(min(256 * 1024, left))
                            if not chunk:
                                break
                            self.wfile.write(chunk)
                            left -= len(chunk)
                except Exception:
                    pass

            def _events(self):
                q = server.session.hub.subscribe()
                try:
                    self.send_response(200)
                    self.send_header("Content-Type", "text/event-stream; charset=utf-8")
                    self.send_header("Cache-Control", "no-store")
                    self.send_header("Connection", "keep-alive")
                    self.end_headers()
                    first = json.dumps(server.session.snapshot(), ensure_ascii=False)
                    self.wfile.write(f"data: {first}\n\n".encode("utf-8"))
                    self.wfile.flush()
                    while True:
                        try:
                            event = q.get(timeout=15)
                            line = "data: " + json.dumps(event, ensure_ascii=False) + "\n\n"
                        except queue.Empty:
                            line = ": ping\n\n"
                        self.wfile.write(line.encode("utf-8"))
                        self.wfile.flush()
                except Exception:
                    pass
                finally:
                    server.session.hub.unsubscribe(q)

            def do_POST(self):
                path, query = self._query()
                if not self._allowed(query) or path != "/cmd":
                    self._send(403, "{}")
                    return
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                    data = json.loads(self.rfile.read(min(size, 65536)).decode("utf-8") or "{}")
                    result = server.session.command(data)
                except Exception as e:
                    server.session.p.log(f"команда: {e}")
                    result = {"ok": False, "error": str(e)}
                self._send(200, json.dumps(result, ensure_ascii=False))

        class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
            daemon_threads = True
            allow_reuse_address = True

        self.httpd = Server(("127.0.0.1", 0), Handler)
        self.port = self.httpd.server_address[1]
        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()

    def url(self):
        return f"http://127.0.0.1:{self.port}/?t={self.token}"

    def stop(self):
        if self.httpd is not None:
            try:
                self.httpd.shutdown()
                self.httpd.server_close()
            except Exception:
                pass
            self.httpd = None


class JoinLinkHook(MethodHook):
    """Клик по ссылке wtogether.join/1234 в чате — сразу входим в комнату."""

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            url = str(param.args[1]) if len(param.args) > 1 else ""
        except Exception:
            return
        if JOIN_HOST not in url:
            return
        code = find_code(url)
        if code:
            param.setResult(None)
            self.plugin.join_and_open(code)


class WtogetherPlugin(BasePlugin):
    def on_plugin_load(self):
        self.session = Session(self)
        self.server = PlayerServer(self.session)
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.DRAWER_MENU,
            text="🎬 Смотреть вместе",
            on_click=lambda ctx: self.safe(lambda: self.open_player()),
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU,
            text="🎬 Смотреть вместе",
            subtext="Комната для этого чата",
            on_click=lambda ctx: self.safe(lambda: self.open_for_chat(ctx)),
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="🎬 Смотреть вместе",
            on_click=lambda ctx: self.safe(lambda: self.on_message_click(ctx)),
        ))
        try:
            browser = find_class("org.telegram.messenger.browser.Browser")
            self.hook_all_methods(browser, "openUrl", JoinLinkHook(self))
        except Exception as e:
            self.log(f"ссылки входа: {e}")

    def on_plugin_unload(self):
        try:
            self.session.close_room(silent=True)
        finally:
            self.server.stop()

    def create_settings(self):
        return [
            Header(text="Смотреть вместе"),
            Text(text="Открыть плеер", icon="msg_play", accent=True,
                 on_click=lambda view: self.safe(self.open_player)),
            Switch(key="auto_invite", text="Сразу отправлять приглашение в чат", default=True,
                   subtext="Когда комната создана из меню чата"),
            Switch(key="auto_pause", text="Пауза, когда просят подождать", default=True),
            Divider(text="Плагин совместим с Wtogether для exteraGram: друзья с телефона входят "
                         "по тому же коду. Плеер открывается в браузере, видео YouTube и ссылки "
                         ".mp4/.m3u8 играют синхронно."),
        ]

    # --- помощники ---

    def safe(self, fn):
        try:
            fn()
        except Exception as e:
            self.log(f"ошибка: {e}")
            BulletinHelper.show_error(f"Wtogether: {e}")

    def my_uid(self):
        try:
            return int(get_user_config().getClientUserId())
        except Exception:
            return 0

    def my_name(self):
        try:
            user = get_messages_controller().getUser(self.my_uid())
            name = str(getattr(user, "first_name", "") or "").strip()
            return name or "Я"
        except Exception:
            return "Я"

    def open_player(self):
        self.server.start()
        if self.session.hub.count() > 0:
            # Страница уже открыта — просто обновим её.
            self.session.push_snapshot()
            self.session.push({"t": "focus"})
        if open_webview is not None and open_webview(self.server.url(), "🎬 Смотрим вместе"):
            return
        from org.telegram.messenger.browser import Browser
        Browser.openUrl(None, self.server.url())

    def open_for_chat(self, ctx):
        did = int((ctx or {}).get("dialog_id") or (ctx or {}).get("peer") or 0)
        self.session.chat_did = did
        self.session.notice = None
        self.open_player()

    def join_and_open(self, code, did=0):
        self.server.start()
        self.session.join(code, did)
        self.open_player()

    def on_message_click(self, ctx):
        text = message_text(ctx)
        did = int((ctx or {}).get("dialog_id") or (ctx or {}).get("peer") or 0)
        doc = str((ctx or {}).get("document_id") or "")
        if doc.isdigit():
            # Видео из Telegram: как на телефоне — друзья найдут его у себя по id.
            name = str(ctx.get("document_name") or "").strip()
            title = (text.strip().split("\n")[0][:60] if text.strip() else "") or name or "Видео"
            info = {"src": "tg", "doc": int(doc), "title": title}
            if ctx.get("document_duration"):
                info["dur"] = int(float(ctx["document_duration"]))
            self.server.start()
            self.session.start_host(info, did, {"dialog_id": did, "message_id": int(ctx.get("message_id") or 0)})
            self.open_player()
            return
        code = find_code(text)
        if code:
            self.join_and_open(code, did)
            return
        url = find_url(text)
        info = media_from_url(url) if url else None
        if info:
            self.server.start()
            self.session.start_host(info, did)
            self.open_player()
            return
        BulletinHelper.show_info("В сообщении нет ссылки на видео или кода комнаты — открываю плеер")
        self.session.chat_did = did
        self.open_player()


PLAYER_HTML = r'''<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Wtogether · Tristegram</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d0e13; --panel:rgba(255,255,255,.055); --panel2:rgba(255,255,255,.085);
  --stroke:rgba(255,255,255,.09); --stroke2:rgba(255,255,255,.16);
  --text:#f3f3f7; --text2:rgba(243,243,247,.62); --text3:rgba(243,243,247,.4);
  --a1:#F07A0C; --a2:#E8318A; --a3:#5B5CF6; --ok:#34C759; --warn:#FFB340; --bad:#FF453A;
  --grad:linear-gradient(135deg,var(--a1),var(--a2) 55%,var(--a3));
  --r:18px; --ease:cubic-bezier(.2,.8,.2,1); --spring:cubic-bezier(.34,1.56,.64,1);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font:500 14px/1.4 Inter,system-ui,sans-serif;color:var(--text);background:var(--bg);overflow:hidden}
body:before{content:"";position:fixed;inset:-20%;background:
  radial-gradient(40% 35% at 15% 10%,rgba(240,122,12,.22),transparent 70%),
  radial-gradient(35% 35% at 85% 20%,rgba(232,49,138,.18),transparent 70%),
  radial-gradient(45% 45% at 60% 100%,rgba(91,92,246,.2),transparent 70%);filter:blur(10px);z-index:-1}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
input{font:inherit;color:inherit}
.glass{background:var(--panel);border:1px solid var(--stroke);backdrop-filter:blur(30px) saturate(160%);-webkit-backdrop-filter:blur(30px) saturate(160%);border-radius:var(--r)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:42px;padding:0 18px;border-radius:999px;background:var(--panel2);border:1px solid var(--stroke);font-weight:600;transition:transform .25s var(--spring),background .2s}
.btn:hover{background:rgba(255,255,255,.13)} .btn:active{transform:scale(.95)}
.btn.accent{background:var(--grad);border:0;box-shadow:0 8px 30px -8px rgba(232,49,138,.6)}
.btn.danger{color:#ff8a80}
.btn.small{height:34px;padding:0 14px;font-size:13px}
.icon{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--stroke);transition:transform .25s var(--spring),background .2s;font-size:17px}
.icon:hover{background:rgba(255,255,255,.14)} .icon:active{transform:scale(.9)}
.hidden{display:none!important}
.logo{width:34px;height:34px;border-radius:11px;background:var(--grad);display:grid;place-items:center;font-weight:800;box-shadow:0 0 24px -4px rgba(240,122,12,.7)}

/* home */
#home{height:100%;display:grid;place-items:center;padding:24px;overflow:auto}
.home-wrap{width:min(920px,100%)}
.hero{display:flex;align-items:center;gap:16px;margin-bottom:26px}
.hero .logo{width:56px;height:56px;border-radius:18px;font-size:26px}
.hero h1{font-size:30px;font-weight:800;letter-spacing:-.03em}
.hero p{color:var(--text2)}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:760px){.cards{grid-template-columns:1fr}}
.card{padding:22px}
.card h2{font-size:18px;font-weight:700;margin-bottom:4px}
.card .sub{color:var(--text2);margin-bottom:16px}
.field{display:flex;gap:10px}
.field input{flex:1;min-width:0;height:46px;border-radius:14px;border:1px solid var(--stroke2);background:rgba(0,0,0,.25);padding:0 14px;outline:none;transition:border-color .2s,box-shadow .2s}
.field input:focus{border-color:rgba(240,122,12,.8);box-shadow:0 0 0 4px rgba(240,122,12,.15)}
.digits{display:flex;gap:10px;margin-bottom:14px}
.digits input{width:56px;height:64px;text-align:center;font-size:28px;font-weight:700;border-radius:16px;border:1px solid var(--stroke2);background:rgba(0,0,0,.25);outline:none}
.digits input:focus{border-color:rgba(91,92,246,.9);box-shadow:0 0 0 4px rgba(91,92,246,.2)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{font-size:12px;padding:5px 10px;border-radius:99px;background:var(--panel2);border:1px solid var(--stroke);color:var(--text2)}
.notice{margin-bottom:16px;padding:14px 16px;border-radius:14px;background:rgba(255,179,64,.12);border:1px solid rgba(255,179,64,.3);color:#ffd08a}
.target{margin-top:14px;color:var(--text3);font-size:13px}

/* room */
#room{height:100%;display:grid;grid-template-rows:auto 1fr;gap:12px;padding:12px}
.top{display:flex;align-items:center;gap:12px;padding:10px 12px}
.top .title{flex:1;min-width:0}
.top .title b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top .title small{color:var(--text2);display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--warn);box-shadow:0 0 10px currentColor}
.dot.on{background:var(--ok)}
.code{font-weight:800;letter-spacing:.18em;padding:6px 12px 6px 14px;border-radius:12px;background:rgba(0,0,0,.25);border:1px solid var(--stroke2);cursor:pointer}
.faces{display:flex}
.face{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:13px;border:2px solid var(--bg);margin-left:-8px;position:relative}
.face:first-child{margin-left:0}
.main{display:grid;grid-template-columns:1fr 340px;gap:12px;min-height:0}
@media(max-width:980px){.main{grid-template-columns:1fr}.side{display:none}.side.open{display:flex;position:fixed;inset:70px 12px 12px auto;width:min(360px,92vw);z-index:20}}
.stage{position:relative;display:flex;flex-direction:column;min-height:0;overflow:hidden;padding:0}
.screen{position:relative;flex:1;min-height:0;background:#000;border-radius:var(--r) var(--r) 0 0;overflow:hidden}
.screen video,.screen #yt,.screen iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#000}
.overlay{position:absolute;inset:0;display:grid;place-items:center;background:rgba(8,8,12,.62);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);z-index:5;padding:20px;text-align:center}
.ocard{max-width:440px;width:100%}
.ocard h3{font-size:20px;font-weight:800;margin-bottom:6px}
.ocard p{color:var(--text2);margin-bottom:16px}
.people{display:flex;flex-direction:column;gap:8px;margin:16px 0;text-align:left}
.person{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:14px;background:rgba(255,255,255,.04)}
.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:700;flex:none}
.person .n{flex:1;min-width:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.person .s{font-size:12px;color:var(--text2)}
.bar{height:4px;border-radius:4px;background:rgba(255,255,255,.1);overflow:hidden;margin-top:4px}
.bar i{display:block;height:100%;background:var(--grad);border-radius:4px;transition:width .3s}
.count{font-size:120px;font-weight:800;line-height:1;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;animation:pop .9s var(--spring) infinite}
@keyframes pop{0%{transform:scale(.6);opacity:0}25%{transform:scale(1);opacity:1}100%{transform:scale(1);opacity:.9}}
.lock{position:absolute;top:12px;left:12px;z-index:4;padding:6px 12px;border-radius:99px;background:rgba(0,0,0,.45);backdrop-filter:blur(12px);font-size:12px;font-weight:600}
.controls{display:flex;align-items:center;gap:10px;padding:12px 14px;border-top:1px solid var(--stroke)}
.seek{flex:1;display:flex;align-items:center;gap:10px;min-width:120px}
.time{font-variant-numeric:tabular-nums;color:var(--text2);font-size:12px;min-width:42px;text-align:center}
.track{position:relative;flex:1;height:6px;border-radius:6px;background:rgba(255,255,255,.12);cursor:pointer}
.track .fill{position:absolute;left:0;top:0;bottom:0;border-radius:6px;background:var(--grad)}
.track .knob{position:absolute;top:50%;width:14px;height:14px;border-radius:50%;background:#fff;transform:translate(-50%,-50%);box-shadow:0 2px 8px rgba(0,0,0,.4)}
.track.locked{cursor:default}
.play{width:48px;height:48px;font-size:20px;background:var(--grad);border:0;box-shadow:0 8px 24px -8px rgba(232,49,138,.7)}
.reacts{display:flex;gap:4px;padding:6px;border-radius:99px;background:rgba(255,255,255,.05);border:1px solid var(--stroke)}
.reacts button{width:34px;height:34px;border-radius:50%;font-size:19px;transition:transform .25s var(--spring),background .2s}
.reacts button:hover{transform:scale(1.25);background:rgba(255,255,255,.08)}
.float{position:absolute;bottom:80px;font-size:34px;pointer-events:none;z-index:6;animation:fly 2.6s var(--ease) forwards}
.float small{display:block;font-size:11px;text-align:center;color:#fff;text-shadow:0 1px 4px #000}
@keyframes fly{0%{transform:translateY(0) scale(.5);opacity:0}15%{opacity:1;transform:translateY(-30px) scale(1.15)}100%{transform:translateY(-320px) scale(1);opacity:0}}

/* side */
.side{display:flex;flex-direction:column;min-height:0;padding:0;overflow:hidden}
.tabs{display:flex;gap:4px;padding:8px;border-bottom:1px solid var(--stroke)}
.tabs button{flex:1;height:36px;border-radius:12px;font-weight:600;color:var(--text2);transition:background .2s,color .2s}
.tabs button.on{background:var(--grad);color:#fff}
.pane{flex:1;min-height:0;overflow:auto;padding:12px}
.msg{display:flex;gap:8px;margin-bottom:10px;animation:rise .35s var(--spring)}
@keyframes rise{from{transform:translateY(8px);opacity:0}}
.msg .avatar{width:28px;height:28px;font-size:12px}
.bubble{padding:8px 12px;border-radius:16px 16px 16px 6px;background:rgba(255,255,255,.07);max-width:85%;word-wrap:break-word}
.msg.mine{flex-direction:row-reverse}
.msg.mine .bubble{border-radius:16px 16px 6px 16px;background:linear-gradient(135deg,rgba(240,122,12,.35),rgba(232,49,138,.35))}
.bubble b{display:block;font-size:12px;margin-bottom:2px}
.at{font-size:11px;color:var(--text3);margin-left:6px;cursor:pointer}
.compose{display:flex;gap:8px;padding:10px;border-top:1px solid var(--stroke)}
.compose input{flex:1;min-width:0;height:40px;border-radius:99px;border:1px solid var(--stroke2);background:rgba(0,0,0,.25);padding:0 14px;outline:none}
.empty{color:var(--text3);text-align:center;padding:30px 10px}
.toasts{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);display:flex;flex-direction:column;gap:8px;z-index:50;align-items:center}
.toast{padding:10px 18px;border-radius:99px;background:rgba(30,30,38,.85);border:1px solid var(--stroke2);backdrop-filter:blur(20px);box-shadow:0 10px 30px -10px #000;animation:rise .35s var(--spring);font-weight:600}
.menu{position:fixed;z-index:60;min-width:220px;padding:6px;border-radius:16px;background:rgba(32,32,40,.92);border:1px solid var(--stroke2);backdrop-filter:blur(30px);box-shadow:0 30px 60px -20px #000}
.menu button{display:flex;width:100%;align-items:center;gap:10px;padding:10px 12px;border-radius:11px;text-align:left}
.menu button:hover{background:rgba(255,255,255,.08)}
.speed{min-width:52px;height:34px;border-radius:99px;font-weight:700;font-size:12px;background:var(--panel2);border:1px solid var(--stroke)}
</style>
</head>
<body>
<div id="home">
  <div class="home-wrap">
    <div class="hero">
      <div class="logo">▶</div>
      <div><h1>Смотрим вместе</h1><p>Wtogether для Tristegram — те же комнаты, что и в exteraGram на телефоне</p></div>
    </div>
    <div id="notice" class="notice hidden"></div>
    <div class="cards">
      <div class="card glass">
        <h2>🎬 Создать комнату</h2>
        <div class="sub">Ссылка на YouTube, .mp4 или .m3u8. Ты будешь управлять просмотром 👑</div>
        <div class="field"><input id="url" placeholder="https://youtu.be/…" autocomplete="off"><button class="btn accent" id="create">Создать</button></div>
        <div class="chips"><span class="chip">YouTube</span><span class="chip">.mp4</span><span class="chip">.m3u8</span><span class="chip">Код из 4 цифр</span></div>
        <div class="target hidden" id="target">Приглашение уйдёт в чат, из которого ты открыл плеер</div>
      </div>
      <div class="card glass">
        <h2>🔑 Войти по коду</h2>
        <div class="sub">Попроси код у ведущего — с телефона или с ПК, без разницы</div>
        <div class="digits" id="digits"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"><input maxlength="1" inputmode="numeric"></div>
        <button class="btn" id="joinBtn" style="width:100%">Войти в комнату</button>
      </div>
    </div>
  </div>
</div>

<div id="room" class="hidden">
  <div class="top glass">
    <button class="icon" id="homeBtn" title="Назад">‹</button>
    <div class="logo">▶</div>
    <div class="title"><b id="vtitle">Видео</b><small><span class="dot" id="netdot"></span><span id="netText">подключаюсь…</span></small></div>
    <div class="faces" id="faces"></div>
    <div class="code" id="code" title="Скопировать код">····</div>
    <button class="btn small accent" id="inviteBtn">Пригласить</button>
    <button class="icon" id="sideBtn" title="Чат">💬</button>
    <button class="icon" id="moreBtn" title="Ещё">⋯</button>
  </div>
  <div class="main">
    <div class="stage glass">
      <div class="screen" id="screen">
        <div id="lock" class="lock hidden"></div>
        <div id="overlay" class="overlay hidden"><div class="ocard" id="ocard"></div></div>
      </div>
      <div class="controls">
        <button class="icon" id="back10" title="−10 с">⟲</button>
        <button class="icon play" id="playBtn">▶</button>
        <button class="icon" id="fwd10" title="+10 с">⟳</button>
        <div class="seek"><span class="time" id="tcur">0:00</span><div class="track" id="track"><div class="fill" id="fill"></div><div class="knob" id="knob"></div></div><span class="time" id="tdur">0:00</span></div>
        <button class="speed" id="speedBtn">1×</button>
        <div class="reacts" id="reacts"></div>
        <button class="icon" id="waitBtn" title="Подожди меня">✋</button>
        <button class="icon" id="fsBtn" title="Во весь экран">⛶</button>
      </div>
    </div>
    <div class="side glass" id="side">
      <div class="tabs"><button class="on" data-tab="chat">Чат</button><button data-tab="people">Участники <span id="pcount"></span></button></div>
      <div class="pane" id="chatPane"><div class="empty">Пиши сюда — сообщения видят все в комнате, с отметкой времени видео</div></div>
      <div class="pane hidden" id="peoplePane"></div>
      <div class="compose" id="compose"><input id="chatInput" placeholder="Сообщение…" maxlength="300"><button class="icon" id="sendBtn">➤</button></div>
    </div>
  </div>
</div>
<div class="toasts" id="toasts"></div>

<script>
const TOKEN = "__TOKEN__";
const $ = (s, r = document) => r.querySelector(s);
const SMALL_DRIFT = 150, BIG_DRIFT = 2000, NUDGE = 0.08, NUDGE_DONE = 80;
const COUNTDOWN_MS = 3000, HEARTBEAT_MS = 3000, SEEK_COOLDOWN = 1500;
const SPEEDS = [1, 1.25, 1.5, 2, 0.75];
const REACTS = ["😂", "❤️", "🔥", "😮", "😭", "👏"];
const COLORS = ["#F07A0C", "#E8318A", "#5B5CF6", "#30B0C7", "#34C759", "#AF52DE", "#FF453A", "#FF9F0A"];

let S = { me: 0, name: "", room: null, chat: [], chatTarget: false, notice: null, media: null };
let P = null;              // player
let lastBeat = 0, seekBlock = 0, nudging = false, countdownAt = 0, started = false, lastInfoKey = "";
let reportedStage = "", userGesture = false;

/* ---------- связь с плагином ---------- */
function api(body) {
  return fetch(`/cmd?t=${TOKEN}`, { method: "POST", body: JSON.stringify(body) })
    .then(r => r.json()).catch(() => ({ ok: false, error: "Плагин не отвечает" }));
}
function connect() {
  const es = new EventSource(`/events?t=${TOKEN}`);
  es.onmessage = e => { try { handle(JSON.parse(e.data)); } catch (x) { console.error(x); } };
  es.onerror = () => setNet(false, "нет связи с Tristegram");
}
function handle(ev) {
  switch (ev.t) {
    case "snapshot": S = Object.assign(S, ev); render(); break;
    case "state": if (S.room) { S.room.st = ev.st; if (ev.offset !== undefined) S.room.offset = ev.offset; renderOverlay(); } break;
    case "clock": if (S.room) { S.room.offset = ev.offset; S.room.rtt = ev.rtt; } break;
    case "status": if (S.room) { S.room.status = ev.status; renderNet(); } break;
    case "members":
      if (S.room) { S.room.members = ev.members; S.room.host = ev.host; renderPeople(); renderFaces(); renderOverlay(); }
      if (ev.joined) toast(`👋 ${nameOf(ev.joined)} в комнате`);
      if (ev.left) toast(`${nameOf(ev.left, "Кто-то")} вышел(а)`);
      break;
    case "chat": S.chat.push(ev.msg); renderChat(); break;
    case "react": floatReact(ev.msg.e, ev.msg.n); break;
    case "wait": onWait(ev.msg); break;
    case "toast": if (ev.text) toast(ev.text); break;
    case "focus": window.focus(); break;
    case "media": S.media = ev.media; renderMedia(); break;
  }
}

/* ---------- помощники ---------- */
const isHost = () => S.room && S.room.role === "host";
const roomNow = () => Date.now() + (isHost() ? 0 : (S.room && S.room.offset) || 0);
function fmt(ms) { let s = Math.max(0, Math.floor(ms / 1000)); const h = Math.floor(s / 3600); s -= h * 3600; const m = Math.floor(s / 60); s -= m * 60; return h ? `${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}` : `${m}:${String(s).padStart(2, "0")}`; }
function colorOf(uid) { let h = 0; for (const c of String(uid)) h = (h * 31 + c.charCodeAt(0)) >>> 0; return COLORS[h % COLORS.length]; }
function nameOf(uid, fallback = "?") { const m = S.room && S.room.members && S.room.members[String(uid)]; return (m && m.n) || (String(uid) === String(S.me) ? S.name : fallback); }
function initial(name) { const ch = Array.from(String(name || "?").trim())[0] || "?"; return ch.toUpperCase(); }
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
function avatar(uid, name, size = 34) { return `<div class="avatar" style="width:${size}px;height:${size}px;background:${colorOf(uid)}">${esc(initial(name))}</div>`; }
function toast(text) { const t = document.createElement("div"); t.className = "toast"; t.textContent = text; $("#toasts").appendChild(t); setTimeout(() => t.remove(), 3200); }
function setNet(on, text) { $("#netdot").classList.toggle("on", on); $("#netText").textContent = text; }

/* ---------- расчёт синхронизации, как на телефоне ---------- */
function expectedPos(st, now) { return st.p ? st.pos + Math.max(0, now - st.ts) * st.r : st.pos; }
function planCorrection(st, now, cur, playing, nudge) {
  const target = expectedPos(st, now), diff = cur - target;
  if (!st.p || now < st.ts) return [false, Math.abs(diff) > SMALL_DRIFT ? target : null, st.r, false];
  if (!playing) return [true, Math.abs(diff) > NUDGE_DONE ? target : null, st.r, false];
  if (Math.abs(diff) > BIG_DRIFT) return [true, target, st.r, false];
  if (Math.abs(diff) > SMALL_DRIFT || (nudge && Math.abs(diff) > NUDGE_DONE)) return [true, null, st.r * (diff > 0 ? 1 - NUDGE : 1 + NUDGE), true];
  return [true, null, st.r, false];
}

/* ---------- плееры ---------- */
function clearScreen() {
  if (P && P.destroy) P.destroy();
  P = null;
  for (const el of [...$("#screen").children]) if (!["lock", "overlay"].includes(el.id)) el.remove();
}
function videoPlayer(src) {
  const v = document.createElement("video");
  v.playsInline = true; v.preload = "auto";
  $("#screen").prepend(v);
  const p = {
    kind: "video", ready: false, fine: true,
    pos: () => v.currentTime * 1000, dur: () => (v.duration || 0) * 1000,
    playing: () => !v.paused && !v.ended, seek: ms => { v.currentTime = Math.max(0, ms / 1000); },
    play: () => v.play().catch(() => needGesture()), pause: () => v.pause(),
    rate: r => { v.playbackRate = r; }, getRate: () => v.playbackRate,
    destroy: () => { v.pause(); v.removeAttribute("src"); v.load(); if (p.hls) p.hls.destroy(); },
    el: v,
  };
  v.addEventListener("loadedmetadata", () => { p.ready = true; onReady(); });
  v.addEventListener("waiting", () => progress("buffering", 100));
  v.addEventListener("playing", () => progress("ready", 100));
  v.addEventListener("ended", () => { if (isHost()) publish(); });
  v.addEventListener("error", () => showCard(`<h3>Видео не открывается</h3><p>Ссылка недоступна из браузера или формат не поддерживается.</p>`));
  v.addEventListener("progress", () => { if (!p.ready && v.buffered.length && v.duration) progress("loading", Math.round(v.buffered.end(0) / v.duration * 100)); });
  const isHls = /\.m3u8(\?|$)/i.test(src);
  if (isHls && !v.canPlayType("application/vnd.apple.mpegurl")) {
    const s = document.createElement("script");
    s.src = "https://cdnjs.cloudflare.com/ajax/libs/hls.js/1.5.13/hls.min.js";
    s.onload = () => { p.hls = new Hls(); p.hls.loadSource(src); p.hls.attachMedia(v); };
    document.head.appendChild(s);
  } else {
    v.src = src;
  }
  return p;
}
let ytApi = null;
function loadYT() {
  if (ytApi) return ytApi;
  ytApi = new Promise(res => { window.onYouTubeIframeAPIReady = () => res(); const s = document.createElement("script"); s.src = "https://www.youtube.com/iframe_api"; document.head.appendChild(s); });
  return ytApi;
}
function ytPlayer(id) {
  const holder = document.createElement("div"); holder.id = "yt"; $("#screen").prepend(holder);
  const p = { kind: "yt", ready: false, fine: false, yt: null, rateNow: 1,
    pos: () => p.yt && p.yt.getCurrentTime ? p.yt.getCurrentTime() * 1000 : 0,
    dur: () => p.yt && p.yt.getDuration ? p.yt.getDuration() * 1000 : 0,
    playing: () => p.yt && p.yt.getPlayerState && p.yt.getPlayerState() === 1,
    seek: ms => p.yt && p.yt.seekTo(Math.max(0, ms / 1000), true),
    play: () => p.yt && p.yt.playVideo(), pause: () => p.yt && p.yt.pauseVideo(),
    rate: r => { const allowed = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2]; const best = allowed.reduce((a, b) => Math.abs(b - r) < Math.abs(a - r) ? b : a); if (best !== p.rateNow) { p.rateNow = best; p.yt && p.yt.setPlaybackRate(best); } },
    getRate: () => p.rateNow,
    destroy: () => { try { p.yt.destroy(); } catch (e) {} },
  };
  loadYT().then(() => {
    p.yt = new YT.Player("yt", { videoId: id, playerVars: { controls: 0, disablekb: 1, rel: 0, modestbranding: 1, playsinline: 1, iv_load_policy: 3, origin: location.origin },
      events: { onReady: () => { p.ready = true; onReady(); },
        onStateChange: e => { if (e.data === 3) progress("buffering", 100); else if (e.data === 1) progress("ready", 100); else if (e.data === 0 && isHost()) publish(); },
        onError: () => showCard(`<h3>YouTube не даёт показать это видео</h3><p>Владелец запретил встраивание. Выберите другое видео.</p>`) } });
  });
  return p;
}
function renderMedia() {
  const r = S.room; if (!r || !r.info || (r.info.src || "tg") !== "tg") return;
  if (P && P.fromTelegram) return;
  const m = S.media || {}, title = r.info.title || "Видео";
  if (m.state === "done" && m.url) {
    hideOverlay();
    P = videoPlayer(m.url); P.fromTelegram = true;
  } else if (!m.state || m.state === "searching") {
    showCard(`<h3>Ищу видео в Telegram…</h3><p>«${esc(title)}» — сначала в чате с ведущим, потом во всех чатах.</p>`, "media");
  } else if (m.state === "loading") {
    const pc = m.total ? Math.floor(m.ready / m.total * 100) : 0;
    showCard(`<h3>Загружаю видео из Telegram</h3><p>«${esc(title)}» · ${pc}%</p><div class="bar" style="height:8px"><i style="width:${pc}%"></i></div>`, "media");
  } else {
    const why = m.state === "missing" ? `Видео «${esc(title)}» не нашлось в твоих чатах — попроси ведущего переслать его тебе.`
      : `«${esc(title)}». Сохрани видео из чата на компьютер и выбери файл — дальше всё синхронно.`;
    localFilePlayer(title, why);
  }
}
function localFilePlayer(title, why) {
  showCard(`<h3>Видео из Telegram</h3><p>${why || `«${esc(title || "Видео")}». Сохрани видео из чата на компьютер и выбери файл — дальше всё синхронно.`}</p><label class="btn accent">Выбрать файл<input type="file" accept="video/*" class="hidden" id="pickFile"></label>`);
  $("#pickFile").addEventListener("change", e => {
    const f = e.target.files[0]; if (!f) return;
    userGesture = true; hideOverlay();
    P = videoPlayer(URL.createObjectURL(f));
  });
}
function openSource(info) {
  const key = JSON.stringify([info.src, info.yt, info.url, info.doc]);
  if (key === lastInfoKey && P) return;
  lastInfoKey = key; clearScreen(); started = false; reportedStage = "";
  if ($("#ocard").dataset.kind === "connect") hideOverlay();
  $("#vtitle").textContent = info.title || "Видео";
  if (info.src === "yt") P = ytPlayer(info.yt);
  else if (info.src === "url") P = videoPlayer(info.url);
  else renderMedia();
  progress("loading", 0);
}
function onReady() {
  if (isHost() && !S.room.st) publish(false);
  progress("ready", 100);
  renderOverlay();
}
function progress(stage, pc) {
  const key = stage + Math.floor(pc / 10);
  if (key === reportedStage) return;
  reportedStage = key;
  api({ a: "progress", stage, pc });
}
function needGesture() {
  if (userGesture) return;
  showCard(`<h3>Нажми, чтобы смотреть</h3><p>Браузер разрешает звук только после нажатия.</p><button class="btn accent" id="gesture">▶ Смотреть со всеми</button>`);
  $("#gesture").onclick = () => { userGesture = true; hideOverlay(); if (P) { P.play(); setTimeout(() => P && !S.room.st?.p && P.pause(), 200); } };
}

/* ---------- ведущий ---------- */
function publish(playing, ts) {
  if (!isHost() || !P || !P.ready) return;
  const p = playing === undefined ? P.playing() : playing;
  lastBeat = Date.now();
  api({ a: "state", p, pos: Math.round(P.pos()), r: P.getRate() || 1, ts: ts || Date.now() });
}
function hostStart() {
  if (!isHost() || !P || !P.ready) return;
  userGesture = true;
  countdownAt = Date.now() + COUNTDOWN_MS; started = true;
  publish(true, countdownAt);
  renderOverlay();
}
function hostToggle() {
  if (!started && !(S.room.st && S.room.st.p)) { hostStart(); return; }
  if (P.playing()) P.pause(); else P.play();
  setTimeout(() => publish(), 120);
}
function hostSeek(ms) { if (!P) return; P.seek(ms); setTimeout(() => publish(), 250); }
function onWait(msg) {
  const n = msg.n || "Кто-то";
  if (isHost() && P && P.playing()) { P.pause(); publish(false); toast(`⏸ Пауза — ${n} просит подождать`); }
  else toast(`✋ ${n} просит подождать`);
}

/* ---------- цикл ---------- */
function tick() {
  const r = S.room;
  if (r && P && P.ready) {
    if (isHost()) {
      if (countdownAt) {
        const left = countdownAt - Date.now();
        if (left <= 0) { countdownAt = 0; P.play(); hideOverlay(); }
        else showCount(left);
      } else if (P.playing() && Date.now() - lastBeat > HEARTBEAT_MS) publish();
    } else if (userGesture || P.kind !== "yt") {
      const st = r.st;
      if (!st) { if (P.playing()) P.pause(); }
      else {
        const now = roomNow();
        if (st.p && now < st.ts) showCount(st.ts - now); else if ($("#ocard").dataset.kind === "count") hideOverlay();
        const [play, seekTo, rate, nd] = planCorrection(st, now, P.pos(), P.playing(), nudging);
        if (seekTo !== null && Date.now() > seekBlock) { P.seek(seekTo); seekBlock = Date.now() + SEEK_COOLDOWN; }
        nudging = nd && P.fine;
        P.rate(P.fine ? rate : st.r);
        if (play && !P.playing()) P.play(); else if (!play && P.playing()) P.pause();
      }
    }
    renderTime();
  }
}
setInterval(tick, 300);

/* ---------- отрисовка ---------- */
function render() {
  const r = S.room;
  $("#home").classList.toggle("hidden", !!r);
  $("#room").classList.toggle("hidden", !r);
  const n = $("#notice"); n.classList.toggle("hidden", !S.notice); n.textContent = S.notice || "";
  $("#target").classList.toggle("hidden", !S.chatTarget);
  if (!r) { clearScreen(); lastInfoKey = ""; return; }
  $("#code").textContent = r.code || "····";
  if (r.info) openSource(r.info);
  else showCard(`<h3>Подключаюсь к комнате ${esc(r.code)}…</h3><p>Ищу ведущего на сервере ${esc(r.broker || "")}</p>`, "connect");
  renderNet(); renderFaces(); renderPeople(); renderChat(); renderControls(); renderOverlay();
}
function renderNet() {
  const r = S.room; if (!r) return;
  const st = String(r.status || "");
  const on = /подключено|connected/i.test(st) || r.claimed || r.role === "guest" && !!r.info;
  setNet(on, isHost() ? (r.claimed ? `ты ведущий 👑 · ${st || "в сети"}` : "создаю комнату…") : `управляет ${nameOf(r.host, "ведущий")} · ${st || "в сети"}`);
}
function sortedMembers() {
  const r = S.room; const list = Object.entries(r.members || {}).map(([uid, m]) => ({ uid, ...m }));
  if (!list.find(m => String(m.uid) === String(S.me))) list.push({ uid: String(S.me), n: S.name, s: "ready" });
  return list.sort((a, b) => (String(b.uid) === String(r.host)) - (String(a.uid) === String(r.host)) || a.uid - b.uid);
}
function statusText(m) { return { ready: "готов", loading: `загрузка ${m.pc || 0}%`, buffering: "буферизация", joined: "заходит" }[m.s] || (m.s || ""); }
function renderFaces() {
  const list = sortedMembers().slice(0, 5);
  $("#faces").innerHTML = list.map(m => `<div class="face" style="background:${colorOf(m.uid)}" title="${esc(m.n || "?")}">${esc(initial(m.n))}</div>`).join("");
  $("#pcount").textContent = sortedMembers().length;
}
function renderPeople() {
  const r = S.room; if (!r) return;
  $("#peoplePane").innerHTML = sortedMembers().map(m => {
    const host = String(m.uid) === String(r.host), mine = String(m.uid) === String(S.me);
    const give = isHost() && !mine ? `<button class="btn small" data-give="${m.uid}">Передать 👑</button>` : "";
    return `<div class="person">${avatar(m.uid, m.n)}<div style="flex:1;min-width:0"><div class="n">${esc(m.n || "?")}${host ? " 👑" : ""}${mine ? " · ты" : ""}</div><div class="s">${statusText(m)}</div>${m.s === "loading" ? `<div class="bar"><i style="width:${m.pc || 0}%"></i></div>` : ""}</div>${give}</div>`;
  }).join("");
  $("#peoplePane").querySelectorAll("[data-give]").forEach(b => b.onclick = async () => {
    const res = await api({ a: "transfer", uid: Number(b.dataset.give) }); if (!res.ok) toast(res.error);
  });
}
function renderChat() {
  const pane = $("#chatPane");
  if (!S.chat.length) { pane.innerHTML = `<div class="empty">Пиши сюда — сообщения видят все в комнате, с отметкой времени видео</div>`; return; }
  pane.innerHTML = S.chat.map(m => {
    const mine = String(m.u) === String(S.me);
    return `<div class="msg${mine ? " mine" : ""}">${avatar(m.u, m.n, 28)}<div class="bubble"><b style="color:${colorOf(m.u)}">${esc(m.n || "?")}<span class="at" data-at="${m.at}">${fmt(m.at || 0)}</span></b>${esc(m.x || "")}</div></div>`;
  }).join("");
  pane.querySelectorAll("[data-at]").forEach(a => a.onclick = () => { if (isHost()) hostSeek(Number(a.dataset.at)); });
  pane.scrollTop = pane.scrollHeight;
}
function renderControls() {
  const host = isHost();
  for (const id of ["back10", "fwd10", "speedBtn"]) $("#" + id).classList.toggle("hidden", !host);
  $("#waitBtn").classList.toggle("hidden", host);
  $("#track").classList.toggle("locked", !host);
  const lock = $("#lock");
  lock.classList.toggle("hidden", host || !S.room);
  if (S.room && !host) lock.textContent = `👑 Управляет ${nameOf(S.room.host, "ведущий")}`;
  $("#inviteBtn").textContent = S.chatTarget ? "Пригласить в чат" : "Пригласить";
}
function renderTime() {
  if (!P) return;
  const cur = P.pos(), dur = P.dur() || (S.room && S.room.info && S.room.info.dur) || 0;
  $("#tcur").textContent = fmt(cur); $("#tdur").textContent = fmt(dur);
  const pc = dur ? Math.min(100, cur / dur * 100) : 0;
  $("#fill").style.width = pc + "%"; $("#knob").style.left = pc + "%";
  $("#playBtn").textContent = P.playing() ? "❚❚" : "▶";
  $("#speedBtn").textContent = (P.getRate() || 1) + "×";
}
function showCard(html, kind = "card") { const o = $("#overlay"); o.classList.remove("hidden"); const c = $("#ocard"); c.dataset.kind = kind; c.innerHTML = html; }
function hideOverlay() { $("#overlay").classList.add("hidden"); $("#ocard").dataset.kind = ""; }
function showCount(left) {
  const n = Math.ceil(left / 1000);
  if ($("#ocard").dataset.kind === "count" && $("#ocard").dataset.n === String(n)) return;
  showCard(`<div class="count">${n}</div><p style="margin-top:10px">Старт для всех</p>`, "count");
  $("#ocard").dataset.n = String(n);
}
function renderOverlay() {
  const r = S.room; if (!r || !r.info) return;
  if (!P || !P.ready) return;
  const kind = $("#ocard").dataset.kind;
  if (kind === "count") return;
  const st = r.st;
  if (isHost() && !started && !(st && st.p)) {
    const ppl = sortedMembers().map(m => `<div class="person">${avatar(m.uid, m.n)}<div style="flex:1;min-width:0"><div class="n">${esc(m.n || "?")}${String(m.uid) === String(r.host) ? " 👑" : ""}</div><div class="s">${statusText(m)}</div></div></div>`).join("");
    showCard(`<h3>Лобби · комната ${esc(r.code)}</h3><p>Когда все будут готовы — запускай. Друзья с телефона входят по этому же коду.</p><div class="people">${ppl}</div><div style="display:flex;gap:10px;justify-content:center"><button class="btn" id="lobbyInvite">Пригласить</button><button class="btn accent" id="startAll">▶ Начать для всех</button></div>`, "lobby");
    $("#startAll").onclick = hostStart; $("#lobbyInvite").onclick = invite;
  } else if (!isHost() && !userGesture && P.kind === "yt") {
    needGesture();
  } else if (!isHost() && !st) {
    showCard(`<h3>Ждём ведущего</h3><p>${esc(nameOf(r.host, "Ведущий"))} скоро начнёт. Видео уже загружено ✓</p>`, "wait");
  } else if (kind === "lobby" || kind === "wait") {
    hideOverlay();
  }
}

/* ---------- реакции ---------- */
$("#reacts").innerHTML = REACTS.map(e => `<button data-e="${e}">${e}</button>`).join("");
$("#reacts").querySelectorAll("button").forEach(b => b.onclick = () => { api({ a: "react", e: b.dataset.e }); floatReact(b.dataset.e, S.name); });
function floatReact(e, who) {
  const f = document.createElement("div"); f.className = "float";
  f.style.left = (10 + Math.random() * 75) + "%";
  f.innerHTML = `${esc(e)}<small>${esc(who || "")}</small>`;
  $("#screen").appendChild(f); setTimeout(() => f.remove(), 2700);
}

/* ---------- события интерфейса ---------- */
async function invite() { const res = await api({ a: "invite" }); toast(res.ok ? (res.text || "Готово") : res.error); }
$("#inviteBtn").onclick = invite;
$("#code").onclick = async () => { try { await navigator.clipboard.writeText(S.room.code); toast("Код скопирован"); } catch (e) { const res = await api({ a: "copy" }); toast(res.text || "Скопировано"); } };
$("#homeBtn").onclick = () => leave();
$("#sideBtn").onclick = () => $("#side").classList.toggle("open");
$("#playBtn").onclick = () => { userGesture = true; if (!P || !P.ready) return; if (isHost()) hostToggle(); else toast(`Управляет ${nameOf(S.room.host, "ведущий")}. Нажми ✋, чтобы попросить подождать`); };
$("#back10").onclick = () => isHost() && P && hostSeek(P.pos() - 10000);
$("#fwd10").onclick = () => isHost() && P && hostSeek(P.pos() + 10000);
$("#speedBtn").onclick = () => { if (!isHost() || !P) return; const cur = P.getRate() || 1; const nxt = SPEEDS[(SPEEDS.indexOf(cur) + 1) % SPEEDS.length] || 1; P.rate(nxt); setTimeout(() => publish(), 150); };
$("#waitBtn").onclick = () => { api({ a: "wait" }); toast(`✋ Попросил(а) ${nameOf(S.room.host, "ведущего")} подождать`); };
$("#fsBtn").onclick = () => { const s = $(".stage"); document.fullscreenElement ? document.exitFullscreen() : s.requestFullscreen(); };
$("#track").onclick = e => { if (!isHost() || !P) return; const r = e.currentTarget.getBoundingClientRect(); hostSeek((e.clientX - r.left) / r.width * (P.dur() || 0)); };
document.querySelectorAll(".tabs button").forEach(b => b.onclick = () => {
  document.querySelectorAll(".tabs button").forEach(x => x.classList.toggle("on", x === b));
  $("#chatPane").classList.toggle("hidden", b.dataset.tab !== "chat");
  $("#compose").classList.toggle("hidden", b.dataset.tab !== "chat");
  $("#peoplePane").classList.toggle("hidden", b.dataset.tab !== "people");
});
function sendChat() { const i = $("#chatInput"); const x = i.value.trim(); if (!x) return; i.value = ""; api({ a: "chat", text: x, at: Math.round(P ? P.pos() : 0) }); }
$("#sendBtn").onclick = sendChat;
$("#chatInput").addEventListener("keydown", e => { if (e.key === "Enter") sendChat(); });
$("#moreBtn").onclick = e => {
  const m = document.createElement("div"); m.className = "menu";
  const items = [["📋 Скопировать приглашение", async () => { const r = await api({ a: "copy" }); toast(r.text || "Скопировано"); }],
    ["⟳ Догнать ведущего", () => { api({ a: "ping" }); seekBlock = 0; toast("Догоняю ведущего…"); }],
    [isHost() ? "⏹ Закончить для всех" : "🚪 Выйти из комнаты", () => leave()]];
  m.innerHTML = items.map((it, i) => `<button data-i="${i}">${it[0]}</button>`).join("");
  document.body.appendChild(m);
  const r = e.currentTarget.getBoundingClientRect(); m.style.top = (r.bottom + 8) + "px"; m.style.right = (innerWidth - r.right) + "px";
  m.querySelectorAll("button").forEach(b => b.onclick = () => { m.remove(); items[b.dataset.i][1](); });
  setTimeout(() => document.addEventListener("click", function off(ev) { if (!m.contains(ev.target)) { m.remove(); document.removeEventListener("click", off); } }), 0);
};
async function leave() {
  if (isHost() && !confirm("Закончить просмотр для всех?")) return;
  await api({ a: "leave" });
}
$("#create").onclick = async () => {
  userGesture = true;
  const res = await api({ a: "host", url: $("#url").value, keepChat: true });
  if (!res.ok) toast(res.error);
};
$("#url").addEventListener("keydown", e => { if (e.key === "Enter") $("#create").click(); });
const digits = [...document.querySelectorAll("#digits input")];
digits.forEach((d, i) => {
  d.addEventListener("input", () => { d.value = d.value.replace(/\D/g, "").slice(-1); if (d.value && digits[i + 1]) digits[i + 1].focus(); if (digits.every(x => x.value)) $("#joinBtn").click(); });
  d.addEventListener("keydown", e => { if (e.key === "Backspace" && !d.value && digits[i - 1]) digits[i - 1].focus(); });
  d.addEventListener("paste", e => { const t = (e.clipboardData.getData("text") || "").replace(/\D/g, "").slice(0, 4); if (t.length === 4) { e.preventDefault(); t.split("").forEach((c, k) => digits[k].value = c); $("#joinBtn").click(); } });
});
$("#joinBtn").onclick = async () => {
  userGesture = true;
  const code = digits.map(d => d.value).join("");
  const res = await api({ a: "join", code, keepChat: true });
  if (!res.ok) toast(res.error || "Код — 4 цифры");
};
document.addEventListener("keydown", e => {
  if (e.target.tagName === "INPUT") return;
  if (e.code === "Space") { e.preventDefault(); $("#playBtn").click(); }
  if (e.key === "ArrowLeft") $("#back10").click();
  if (e.key === "ArrowRight") $("#fwd10").click();
  if (e.key === "f") $("#fsBtn").click();
});
connect();
</script>
</body>
</html>
'''
